[Unit]
Description=NordVPN Status API for Homepage Dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=root
Group=root
Type=simple
EnvironmentFile=/etc/nord-status-server.env
ExecStart=/usr/bin/python3 -m gunicorn -w 1 -b 192.168.10.9:8787 server:app
WorkingDirectory=/opt/nord-status-server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target