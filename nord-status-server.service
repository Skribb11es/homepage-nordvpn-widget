[Unit]
Description=NordVPN Status API for Homepage Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/nord-status-server.env
ExecStart=/usr/bin/python3 /opt/nord-status-server/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
